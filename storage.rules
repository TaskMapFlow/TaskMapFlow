rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ============================================================
    // AŞAMA 1 BASELINE: DENY ALL
    // Bütün istemci erişimleri varsayılan olarak reddedilir.
    // Not: Firebase Storage kuralları Firestore veritabanına erişebilir
    // (firestore.get / firestore.exists). Ancak Aşama 1'de hiçbir
    // dosya yükleme/indirme işlemi açılmamıştır.
    // ============================================================

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
