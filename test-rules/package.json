{
  "name": "taskmapflow-rules-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Firestore Security Rules and Auth tests using the Firebase Emulator",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:rules": "node --experimental-vm-modules node_modules/.bin/jest firestore.rules.test.js",
    "test:auth": "node --experimental-vm-modules node_modules/.bin/jest auth.emulator.test.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.js"
    ],
    "testTimeout": 30000
  },
  "dependencies": {
    "@firebase/rules-unit-testing": "^3.0.1",
    "firebase-admin": "^13.0.2"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}
