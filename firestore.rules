rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // BASELINE: deny all access by default.
    // Rules are expanded incrementally as features are implemented.
    // Each new feature must add targeted tests before rules are relaxed.
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isWorkspaceMember(workspaceId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    function workspaceRole(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data.role;
    }

    function isWorkspaceOwner(workspaceId) {
      return isWorkspaceMember(workspaceId) && workspaceRole(workspaceId) == 'owner';
    }

    function isWorkspaceAdmin(workspaceId) {
      return isWorkspaceMember(workspaceId) &&
             (workspaceRole(workspaceId) == 'owner' || workspaceRole(workspaceId) == 'admin');
    }

    // Users
    match /users/{userId} {
      allow read, write: if isUser(userId);

      match /performance_notes/{noteId} {
        allow read, write: if isUser(userId);
      }

      match /archive/{itemId} {
        allow read, write: if isUser(userId);
      }
    }

    // Workspaces
    match /workspaces/{workspaceId} {
      allow read: if isWorkspaceMember(workspaceId);
      allow write: if isWorkspaceOwner(workspaceId);

      match /members/{memberId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow write: if isWorkspaceAdmin(workspaceId);
      }

      match /map_nodes/{nodeId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create: if isWorkspaceMember(workspaceId);
        allow update, delete: if isWorkspaceAdmin(workspaceId) ||
                                  (isWorkspaceMember(workspaceId) &&
                                   resource.data.createdBy == request.auth.uid);
      }

      match /map_edges/{edgeId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create: if isWorkspaceMember(workspaceId);
        allow update, delete: if isWorkspaceAdmin(workspaceId) ||
                                  (isWorkspaceMember(workspaceId) &&
                                   resource.data.createdBy == request.auth.uid);
      }

      match /tasks/{taskId} {
        allow read: if isWorkspaceMember(workspaceId) &&
                       (!resource.data.isPrivate || resource.data.createdBy == request.auth.uid);
        allow create: if isWorkspaceMember(workspaceId);
        allow update: if isWorkspaceMember(workspaceId) &&
                         (!resource.data.isPrivate || resource.data.createdBy == request.auth.uid);
        allow delete: if isWorkspaceAdmin(workspaceId) ||
                         resource.data.createdBy == request.auth.uid;
      }

      match /sprints/{sprintId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow write: if isWorkspaceAdmin(workspaceId);
      }

      match /notes/{noteId} {
        allow read: if isWorkspaceMember(workspaceId) &&
                       (!resource.data.isPrivate || resource.data.authorId == request.auth.uid);
        allow create: if isWorkspaceMember(workspaceId);
        allow update: if isWorkspaceMember(workspaceId) &&
                         resource.data.authorId == request.auth.uid;
        allow delete: if isWorkspaceAdmin(workspaceId) ||
                         resource.data.authorId == request.auth.uid;
      }
    }
  }
}
