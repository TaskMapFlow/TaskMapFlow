rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // AŞAMA 1 BASELINE: DENY ALL
    // Bütün istemci erişimleri varsayılan olarak reddedilir.
    // İleriki aşamalarda özellikler geliştirildikçe kurallar
    // kapsamlı testler eşliğinde genişletilecektir.
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
