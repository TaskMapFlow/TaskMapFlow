rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidHexColor(color) {
      return color is string && color.matches('^#[0-9a-fA-F]{6}$');
    }

    function isValidWorkspaceType(type) {
      return type in ['project', 'lesson', 'freeform'];
    }

    function isValidTaskStatus(status) {
      return status in ['todo', 'in_progress', 'completed'];
    }

    function isValidTaskPriority(priority) {
      return priority in ['low', 'medium', 'high'];
    }

    function isValidSprintStatus(status) {
      return status in ['planned', 'active', 'completed'];
    }

    function isValidConnectionType(type) {
      return type in ['related', 'blocks'];
    }

    function isValidMemberRole(role) {
      return role in ['owner', 'admin', 'member'];
    }

    function isValidSubtaskItem(item) {
      return item is map
        && item.keys().hasOnly(['id', 'title', 'isCompleted'])
        && item.id is string && item.id.size() > 0
        && item.title is string && item.title.size() > 0 && item.title.size() <= 100
        && item.isCompleted is bool;
    }

    function isValidSubtasksList(list) {
      return list is list
        && list.size() <= 20
        && (list.size() < 1 || isValidSubtaskItem(list[0]))
        && (list.size() < 2 || isValidSubtaskItem(list[1]))
        && (list.size() < 3 || isValidSubtaskItem(list[2]))
        && (list.size() < 4 || isValidSubtaskItem(list[3]))
        && (list.size() < 5 || isValidSubtaskItem(list[4]))
        && (list.size() < 6 || isValidSubtaskItem(list[5]))
        && (list.size() < 7 || isValidSubtaskItem(list[6]))
        && (list.size() < 8 || isValidSubtaskItem(list[7]))
        && (list.size() < 9 || isValidSubtaskItem(list[8]))
        && (list.size() < 10 || isValidSubtaskItem(list[9]))
        && (list.size() < 11 || isValidSubtaskItem(list[10]))
        && (list.size() < 12 || isValidSubtaskItem(list[11]))
        && (list.size() < 13 || isValidSubtaskItem(list[12]))
        && (list.size() < 14 || isValidSubtaskItem(list[13]))
        && (list.size() < 15 || isValidSubtaskItem(list[14]))
        && (list.size() < 16 || isValidSubtaskItem(list[15]))
        && (list.size() < 17 || isValidSubtaskItem(list[16]))
        && (list.size() < 18 || isValidSubtaskItem(list[17]))
        && (list.size() < 19 || isValidSubtaskItem(list[18]))
        && (list.size() < 20 || isValidSubtaskItem(list[19]));
    }

    function isSubtaskTitleAndIdUnchanged(oldItem, newItem) {
      return newItem is map
        && newItem.id == oldItem.id
        && newItem.title == oldItem.title
        && newItem.isCompleted is bool;
    }

    function areSubtaskTitlesAndIdsPreserved(oldList, newList) {
      return (oldList == null && newList == null)
        || (
          oldList is list && newList is list
          && oldList.size() == newList.size()
          && (oldList.size() < 1 || isSubtaskTitleAndIdUnchanged(oldList[0], newList[0]))
          && (oldList.size() < 2 || isSubtaskTitleAndIdUnchanged(oldList[1], newList[1]))
          && (oldList.size() < 3 || isSubtaskTitleAndIdUnchanged(oldList[2], newList[2]))
          && (oldList.size() < 4 || isSubtaskTitleAndIdUnchanged(oldList[3], newList[3]))
          && (oldList.size() < 5 || isSubtaskTitleAndIdUnchanged(oldList[4], newList[4]))
          && (oldList.size() < 6 || isSubtaskTitleAndIdUnchanged(oldList[5], newList[5]))
          && (oldList.size() < 7 || isSubtaskTitleAndIdUnchanged(oldList[6], newList[6]))
          && (oldList.size() < 8 || isSubtaskTitleAndIdUnchanged(oldList[7], newList[7]))
          && (oldList.size() < 9 || isSubtaskTitleAndIdUnchanged(oldList[8], newList[8]))
          && (oldList.size() < 10 || isSubtaskTitleAndIdUnchanged(oldList[9], newList[9]))
          && (oldList.size() < 11 || isSubtaskTitleAndIdUnchanged(oldList[10], newList[10]))
          && (oldList.size() < 12 || isSubtaskTitleAndIdUnchanged(oldList[11], newList[11]))
          && (oldList.size() < 13 || isSubtaskTitleAndIdUnchanged(oldList[12], newList[12]))
          && (oldList.size() < 14 || isSubtaskTitleAndIdUnchanged(oldList[13], newList[13]))
          && (oldList.size() < 15 || isSubtaskTitleAndIdUnchanged(oldList[14], newList[14]))
          && (oldList.size() < 16 || isSubtaskTitleAndIdUnchanged(oldList[15], newList[15]))
          && (oldList.size() < 17 || isSubtaskTitleAndIdUnchanged(oldList[16], newList[16]))
          && (oldList.size() < 18 || isSubtaskTitleAndIdUnchanged(oldList[17], newList[17]))
          && (oldList.size() < 19 || isSubtaskTitleAndIdUnchanged(oldList[18], newList[18]))
          && (oldList.size() < 20 || isSubtaskTitleAndIdUnchanged(oldList[19], newList[19]))
        );
    }

    function isValidTaskSprint(data, workspaceId, ownerId) {
      return data.sprintId == null
        || (data.sprintId is string
            && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/sprints/$(data.sprintId)));
    }

    function isValidTaskAssignee(workspaceId, assigneeId) {
      return assigneeId == null
        || (
          assigneeId is string
          && (
            get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == assigneeId
            || exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(assigneeId))
          )
        );
    }

    function isValidTask(data, workspaceId, ownerId) {
      return data.keys().hasOnly(['id', 'workspaceId', 'ownerId', 'title', 'description', 'status', 'priority', 'dueDate', 'sprintId', 'subtasks', 'assigneeId', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() > 0
        && data.workspaceId == workspaceId
        && data.ownerId == ownerId
        && data.title is string && data.title.size() > 0 && data.title.size() <= 150
        && data.description is string && data.description.size() <= 1000
        && isValidTaskStatus(data.status)
        && isValidTaskPriority(data.priority)
        && (data.dueDate == null || data.dueDate is timestamp)
        && (data.subtasks == null || isValidSubtasksList(data.subtasks))
        && (!('assigneeId' in data) || data.assigneeId == null || (data.assigneeId is string && data.assigneeId.size() > 0))
        && isValidTaskSprint(data, workspaceId, ownerId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSprint(data, workspaceId, ownerId) {
      return data.keys().hasOnly(['id', 'workspaceId', 'ownerId', 'name', 'goal', 'startDate', 'endDate', 'status', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() > 0
        && data.workspaceId == workspaceId
        && data.ownerId == ownerId
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.goal is string && data.goal.size() <= 500
        && isValidSprintStatus(data.status)
        && data.startDate is timestamp
        && data.endDate is timestamp
        && data.endDate >= data.startDate
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTagItem(item) {
      return item is string && item.size() > 0 && item.size() <= 30;
    }

    function isValidTagsList(list) {
      return list is list
        && list.size() <= 20
        && (list.size() < 1 || isValidTagItem(list[0]))
        && (list.size() < 2 || isValidTagItem(list[1]))
        && (list.size() < 3 || isValidTagItem(list[2]))
        && (list.size() < 4 || isValidTagItem(list[3]))
        && (list.size() < 5 || isValidTagItem(list[4]))
        && (list.size() < 6 || isValidTagItem(list[5]))
        && (list.size() < 7 || isValidTagItem(list[6]))
        && (list.size() < 8 || isValidTagItem(list[7]))
        && (list.size() < 9 || isValidTagItem(list[8]))
        && (list.size() < 10 || isValidTagItem(list[9]))
        && (list.size() < 11 || isValidTagItem(list[10]))
        && (list.size() < 12 || isValidTagItem(list[11]))
        && (list.size() < 13 || isValidTagItem(list[12]))
        && (list.size() < 14 || isValidTagItem(list[13]))
        && (list.size() < 15 || isValidTagItem(list[14]))
        && (list.size() < 16 || isValidTagItem(list[15]))
        && (list.size() < 17 || isValidTagItem(list[16]))
        && (list.size() < 18 || isValidTagItem(list[17]))
        && (list.size() < 19 || isValidTagItem(list[18]))
        && (list.size() < 20 || isValidTagItem(list[19]));
    }

    function isValidResourceItem(item) {
      return item is map
        && item.keys().hasOnly(['id', 'title', 'url'])
        && item.id is string && item.id.size() > 0
        && item.title is string && item.title.size() > 0 && item.title.size() <= 100
        && item.url is string && item.url.size() > 0 && item.url.size() <= 500
        && item.url.matches('^https?://.*');
    }

    function isValidResourcesList(list) {
      return list is list
        && list.size() <= 20
        && (list.size() < 1 || isValidResourceItem(list[0]))
        && (list.size() < 2 || isValidResourceItem(list[1]))
        && (list.size() < 3 || isValidResourceItem(list[2]))
        && (list.size() < 4 || isValidResourceItem(list[3]))
        && (list.size() < 5 || isValidResourceItem(list[4]))
        && (list.size() < 6 || isValidResourceItem(list[5]))
        && (list.size() < 7 || isValidResourceItem(list[6]))
        && (list.size() < 8 || isValidResourceItem(list[7]))
        && (list.size() < 9 || isValidResourceItem(list[8]))
        && (list.size() < 10 || isValidResourceItem(list[9]))
        && (list.size() < 11 || isValidResourceItem(list[10]))
        && (list.size() < 12 || isValidResourceItem(list[11]))
        && (list.size() < 13 || isValidResourceItem(list[12]))
        && (list.size() < 14 || isValidResourceItem(list[13]))
        && (list.size() < 15 || isValidResourceItem(list[14]))
        && (list.size() < 16 || isValidResourceItem(list[15]))
        && (list.size() < 17 || isValidResourceItem(list[16]))
        && (list.size() < 18 || isValidResourceItem(list[17]))
        && (list.size() < 19 || isValidResourceItem(list[18]))
        && (list.size() < 20 || isValidResourceItem(list[19]));
    }

    function isValidNote(data, workspaceId, ownerId) {
      return data.keys().hasOnly(['id', 'workspaceId', 'ownerId', 'title', 'content', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() > 0
        && data.workspaceId == workspaceId
        && data.ownerId == ownerId
        && data.title is string && data.title.size() <= 150
        && data.content is string && data.content.size() > 0 && data.content.size() <= 5000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGithubUrl(url) {
      return url is string
        && (url == '' || (url.size() <= 200 && url.matches('^https://(www\\.)?github\\.com/[a-zA-Z0-9_-]+/?.*$')));
    }

    function isValidProfile(data, userId) {
      return data.keys().hasOnly(['id', 'displayName', 'bio', 'githubUrl', 'createdAt', 'updatedAt'])
        && data.id == userId
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
        && data.bio is string && data.bio.size() <= 300
        && isValidGithubUrl(data.githubUrl)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isWorkspaceActive(workspaceId) {
      return !('isArchived' in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data)
        || get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.isArchived == false;
    }

    function isValidWorkspace(data, ownerId) {
      return data.keys().hasOnly(['id', 'name', 'description', 'type', 'color', 'ownerId', 'tags', 'resources', 'isArchived', 'archivedAt', 'isTeamEnabled', 'memberIds', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() > 0
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.description is string && data.description.size() <= 500
        && isValidWorkspaceType(data.type)
        && isValidHexColor(data.color)
        && data.ownerId == ownerId
        && (!('tags' in data) || isValidTagsList(data.tags))
        && (!('resources' in data) || isValidResourcesList(data.resources))
        && (!('isArchived' in data) || data.isArchived is bool)
        && (!('archivedAt' in data) || data.archivedAt == null || data.archivedAt is timestamp)
        && (!('isTeamEnabled' in data) || data.isTeamEnabled is bool)
        && (!('memberIds' in data) || data.memberIds is list)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMapNode(data, ownerId) {
      return data.keys().hasOnly(['id', 'workspaceId', 'ownerId', 'positionX', 'positionY', 'width', 'height', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() > 0
        && data.workspaceId is string && data.workspaceId.size() > 0
        && data.ownerId == ownerId
        && data.positionX is number
        && data.positionY is number
        && data.width is number && data.width >= 60 && data.width <= 1000
        && data.height is number && data.height >= 40 && data.height <= 800
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMapConnection(data, ownerId) {
      return data.keys().hasOnly(['id', 'ownerId', 'sourceWorkspaceId', 'targetWorkspaceId', 'type', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() > 0
        && data.ownerId == ownerId
        && data.sourceWorkspaceId is string && data.sourceWorkspaceId.size() > 0
        && data.targetWorkspaceId is string && data.targetWorkspaceId.size() > 0
        && data.sourceWorkspaceId != data.targetWorkspaceId
        && isValidConnectionType(data.type)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isWorkspaceMember(workspaceId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid))
        || (exists(/databases/$(database)/documents/workspaces/$(workspaceId))
            && 'memberIds' in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data
            && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds)
      );
    }

    function isWorkspaceOwnerOrMember(workspaceId) {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid
        || isWorkspaceMember(workspaceId)
      );
    }

    function getMemberRole(workspaceId) {
      return exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid))
        ? get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data.role
        : (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid ? 'owner' : 'none');
    }

    function isWorkspaceAdminOrOwner(workspaceId) {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid
        || getMemberRole(workspaceId) in ['owner', 'admin']
      );
    }

    // Workspaces collection
    match /workspaces/{workspaceId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid
        || ('memberIds' in resource.data && request.auth.uid in resource.data.memberIds)
      );
      
      allow create: if isAuthenticated() 
        && isValidWorkspace(request.resource.data, request.auth.uid)
        && request.resource.data.id == workspaceId;
        
      allow update: if isAuthenticated()
        && (
          // Owner update
          (
            resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.id == workspaceId
            && isValidWorkspace(request.resource.data, resource.data.ownerId)
            && (
              // Team enablement (only initial toggle by owner)
              (
                (!('isTeamEnabled' in resource.data) || resource.data.isTeamEnabled == false)
                && request.resource.data.isTeamEnabled == true
                && request.resource.data.memberIds == [resource.data.ownerId]
              )
              // Standard active workspace update (memberIds can NOT be modified by client)
              || (
                (!('isArchived' in resource.data) || resource.data.isArchived == false)
                && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberIds']))
                && (!('isTeamEnabled' in resource.data) || request.resource.data.isTeamEnabled == resource.data.isTeamEnabled)
              )
              // Restore from archived
              || (
                resource.data.isArchived == true
                && request.resource.data.isArchived == false
                && request.resource.data.name == resource.data.name
                && request.resource.data.type == resource.data.type
                && request.resource.data.color == resource.data.color
                && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberIds']))
              )
            )
          )
          // Admin info update: strictly restricted to description, tags, resources, updatedAt
          || (
            isWorkspaceAdminOrOwner(workspaceId)
            && isWorkspaceActive(workspaceId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['description', 'tags', 'resources', 'updatedAt'])
            && (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 500))
            && (!('tags' in request.resource.data) || isValidTagsList(request.resource.data.tags))
            && (!('resources' in request.resource.data) || isValidResourcesList(request.resource.data.resources))
            && request.resource.data.updatedAt is timestamp
          )
        );
        
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      // Members subcollection: managed securely by Cloud Functions backend
      match /members/{memberId} {
        allow read: if isAuthenticated() && isWorkspaceOwnerOrMember(workspaceId);

        // Initial owner self-registration when enabling team mode
        allow create: if isAuthenticated() && isWorkspaceActive(workspaceId) && (
          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid
          && memberId == request.auth.uid
          && request.resource.data.role == 'owner'
        );

        // Role changes and removals must be done through Cloud Functions
        allow update, delete: if false;
      }

      // Invites subcollection (read-only for workspace admin/owner; write only via callable Cloud Functions)
      match /invites/{inviteId} {
        allow read: if isAuthenticated() && isWorkspaceAdminOrOwner(workspaceId);
        allow write: if false;
      }

      // Tasks subcollection
      match /tasks/{taskId} {
        allow read: if isAuthenticated() && isWorkspaceOwnerOrMember(workspaceId);
          
        allow create: if isAuthenticated()
          && isWorkspaceActive(workspaceId)
          && isWorkspaceOwnerOrMember(workspaceId)
          && isValidTask(request.resource.data, workspaceId, request.auth.uid)
          && request.resource.data.id == taskId
          && isValidTaskAssignee(workspaceId, request.resource.data.assigneeId)
          && (
            isWorkspaceAdminOrOwner(workspaceId)
            || request.resource.data.assigneeId == null
            || request.resource.data.assigneeId == request.auth.uid
          );
          
        allow update: if isAuthenticated()
          && isWorkspaceActive(workspaceId)
          && isWorkspaceOwnerOrMember(workspaceId)
          && (
            // Workspace owner, admin, or task creator full update
            (
              (isWorkspaceAdminOrOwner(workspaceId) || resource.data.ownerId == request.auth.uid)
              && request.resource.data.id == resource.data.id
              && request.resource.data.workspaceId == workspaceId
              && request.resource.data.ownerId == resource.data.ownerId
              && request.resource.data.createdAt == resource.data.createdAt
              && isValidTask(request.resource.data, workspaceId, resource.data.ownerId)
              && isValidTaskAssignee(workspaceId, request.resource.data.assigneeId)
              && (
                isWorkspaceAdminOrOwner(workspaceId)
                || request.resource.data.assigneeId == null
                || request.resource.data.assigneeId == request.auth.uid
              )
            )
            // Task Assignee status and subtasks only update (assignee cannot alter title/id)
            || (
              ('assigneeId' in resource.data && resource.data.assigneeId == request.auth.uid)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'subtasks', 'updatedAt'])
              && isValidTaskStatus(request.resource.data.status)
              && areSubtaskTitlesAndIdsPreserved(resource.data.subtasks, request.resource.data.subtasks)
              && request.resource.data.updatedAt is timestamp
            )
          );
          
        allow delete: if isAuthenticated()
          && isWorkspaceActive(workspaceId)
          && isWorkspaceOwnerOrMember(workspaceId)
          && (
            isWorkspaceAdminOrOwner(workspaceId)
            || resource.data.ownerId == request.auth.uid
          );
      }

      // Sprints subcollection – owner/admin access
      match /sprints/{sprintId} {
        allow read: if isAuthenticated() && isWorkspaceOwnerOrMember(workspaceId);
          
        allow create: if isAuthenticated()
          && isWorkspaceActive(workspaceId)
          && isWorkspaceAdminOrOwner(workspaceId)
          && isValidSprint(request.resource.data, workspaceId, request.auth.uid)
          && request.resource.data.id == sprintId;
          
        allow update: if isAuthenticated()
          && isWorkspaceActive(workspaceId)
          && isWorkspaceAdminOrOwner(workspaceId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt
          && isValidSprint(request.resource.data, workspaceId, resource.data.ownerId);
          
        allow delete: if isAuthenticated()
          && isWorkspaceActive(workspaceId)
          && isWorkspaceAdminOrOwner(workspaceId);
      }

      // Notes subcollection
      match /notes/{noteId} {
        allow read: if isAuthenticated() && isWorkspaceOwnerOrMember(workspaceId);
          
        allow create: if isAuthenticated()
          && isWorkspaceActive(workspaceId)
          && isWorkspaceOwnerOrMember(workspaceId)
          && isValidNote(request.resource.data, workspaceId, request.auth.uid)
          && request.resource.data.id == noteId;
          
        allow update: if isAuthenticated()
          && isWorkspaceActive(workspaceId)
          && isWorkspaceOwnerOrMember(workspaceId)
          && (
            resource.data.ownerId == request.auth.uid
            || isWorkspaceAdminOrOwner(workspaceId)
          )
          && request.resource.data.id == resource.data.id
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt
          && isValidNote(request.resource.data, workspaceId, resource.data.ownerId);
          
        allow delete: if isAuthenticated()
          && isWorkspaceActive(workspaceId)
          && isWorkspaceOwnerOrMember(workspaceId)
          && (
            resource.data.ownerId == request.auth.uid
            || isWorkspaceAdminOrOwner(workspaceId)
          );
      }
    }

    // Collection Group queries for tasks – strictly require active workspace membership or ownership
    match /{path=**}/tasks/{taskId} {
      allow read: if isAuthenticated()
        && isWorkspaceOwnerOrMember(resource.data.workspaceId)
        && (
          resource.data.ownerId == request.auth.uid
          || ('assigneeId' in resource.data && resource.data.assigneeId == request.auth.uid)
        );
    }

    // Top-level invites collection: completely closed to client (callable Cloud Functions only)
    match /invites/{code} {
      allow read, write: if false;
    }

    // Internal rate limits: completely closed to client
    match /_rateLimits/{doc} {
      allow read, write: if false;
    }

    // Map Nodes collection – owner-only access, linked to user's workspace
    match /map_nodes/{nodeId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      
      allow create: if isAuthenticated() 
        && isValidMapNode(request.resource.data, request.auth.uid)
        && request.resource.data.id == nodeId
        && getAfter(/databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)).data.ownerId == request.auth.uid;
        
      allow update: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.id == nodeId
        && isWorkspaceActive(resource.data.workspaceId)
        && isValidMapNode(request.resource.data, resource.data.ownerId);
        
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Map Connections collection – owner-only access, links two user workspaces
    match /map_connections/{connId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      
      allow create: if isAuthenticated()
        && isValidMapConnection(request.resource.data, request.auth.uid)
        && request.resource.data.id == connId
        && get(/databases/$(database)/documents/workspaces/$(request.resource.data.sourceWorkspaceId)).data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/workspaces/$(request.resource.data.targetWorkspaceId)).data.ownerId == request.auth.uid;
        
      allow update: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.sourceWorkspaceId == resource.data.sourceWorkspaceId
        && request.resource.data.targetWorkspaceId == resource.data.targetWorkspaceId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.id == connId
        && isValidMapConnection(request.resource.data, resource.data.ownerId);
        
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // User profile: owner only read and write
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.id == userId
        && isValidProfile(request.resource.data, userId);
      allow update: if isAuthenticated()
        && request.auth.uid == userId
        && resource.data.id == userId
        && request.resource.data.id == userId
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidProfile(request.resource.data, userId);
      allow delete: if false;
    }

    // Baseline catch-all: all other collections strictly denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
